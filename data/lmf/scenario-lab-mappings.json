{
  "schemaVersion": "1.0.0",
  "contractRole": "scenario-to-lab-routing",
  "selectorPolicy": {
    "preferredSelector": "scenario-key",
    "scenarioKeysMustBeExactAndStable": true,
    "symptomCategoriesAreNotRoutingIdentifiers": true,
    "curriculumScenarioIdsRequireExplicitSelectorKind": true
  },
  "rules": {
    "scenarioProvidesInstructionalContextOnly": true,
    "mappingMaySelectWorkspace": true,
    "mappingMaySelectEngineeringReference": true,
    "mappingMayDefineEngineeringBehavior": false,
    "mappingMayGrantAssessmentEligibility": false,
    "mappingMayGrantPublication": false,
    "failClosedOnUnknownLab": true,
    "failClosedOnAmbiguousSelector": true
  },
  "unmappedSelectors": [
    {
      "selector": {
        "kind": "scenario-key",
        "value": "power-loss"
      },
      "reason": "Legacy scenario identifies transmission slip but does not establish an automatic-versus-manual workspace. LMF routing remains fail-closed until that instructional context is governed explicitly."
    }
  ],
  "mappings": [
