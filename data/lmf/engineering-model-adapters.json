{
  "schemaVersion": "1.0.0",
  "contractRole": "engineering-model-adapter-registry",
  "invariant": "Adapters normalize access to authoritative engineering models; they do not transfer engineering authority to scenarios, questions, presentation assets, or UI state.",
  "interface": {
    "requiredInputs": [
      "modelRef",
      "operatingStateId"
    ],
    "optionalInputs": [
      "faultId",
      "measurementRequest",
      "context"
    ],
    "requiredOutputs": [
      "modelIdentity",
      "resolvedState",
      "provenance"
    ],
    "optionalOutputs": [
      "quantities",
      "connections",
      "components",
      "measurementResult",
      "warnings"
    ],
    "prohibitedOutputs": [
      "correctAnswer",
      "score",
      "assessmentEligible",
      "publicationApproved"
    ]
  },
  "adapters": [
    {
      "adapterId": "electrical-circuit",
      "family": "electrical",
      "status": "existing-model-family",
      "authoritativeSourceKinds": [
        "circuit-template",
        "engineering-artifact"
      ],
      "supportedCapabilities": [
        "component-topology",
        "connection-topology",
        "operating-state",
        "fault-selection",
        "electrical-measurement"
      ]
    },
    {
      "adapterId": "network-communications",
      "family": "communications",
      "status": "existing-model-family",
      "authoritativeSourceKinds": [
        "circuit-template",
        "engineering-artifact"
      ],
      "supportedCapabilities": [
        "network-topology",
        "operating-state",
        "fault-selection",
        "network-measurement"
      ]
    },
    {
      "adapterId": "electrified-multivoltage",
      "family": "electrified",
      "status": "existing-model-family",
      "authoritativeSourceKinds": [
        "circuit-template",
        "engineering-artifact"
      ],
      "supportedCapabilities": [
        "voltage-domain-isolation",
        "component-topology",
        "operating-state",
        "fault-selection"
      ]
    },
    {
      "adapterId": "mechanical-engine",
      "family": "mechanical",
      "status": "planned",
      "authoritativeSourceKinds": [
        "future-engineering-model"
      ],
      "supportedCapabilities": [
        "geometry-state",
        "rotational-state",
        "mechanical-measurement"
      ]
    },
    {
