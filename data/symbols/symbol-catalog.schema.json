{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://autolearnpro.com/schemas/symbol-catalog.schema.json",
  "title":"TorqueMind Symbol Catalog",
  "type":"object",
  "required":["domain","version","status","standardReferences","symbols"],
  "properties":{
    "domain":{"enum":["electrical","hydraulic","pneumatic","mechanical","thermal"]},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status":{"type":"string"},
    "standardReferences":{"type":"array","minItems":1,"items":{"type":"string"}},
    "symbols":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/symbol"}}
  },
  "$defs":{
    "terminal":{"type":"object","required":["id","x","y"],"properties":{"id":{"type":"string"},"x":{"type":"number","minimum":0,"maximum":100},"y":{"type":"number","minimum":0,"maximum":100}},"additionalProperties":false},
    "primitive":{"type":"object","required":["type","attrs"],"properties":{"type":{"enum":["line","rect","circle","ellipse","path","polyline","polygon","text"]},"attrs":{"type":"object"},"className":{"type":"string"},"text":{"type":"string"}},"additionalProperties":false},
    "symbol":{"type":"object","required":["id","domain","name","terminals","primitives"],"properties":{"id":{"type":"string","pattern":"^[a-z]+\\.[a-z0-9-]+$"},"domain":{"enum":["electrical","hydraulic","pneumatic","mechanical","thermal"]},"name":{"type":"string","minLength":1},"aliases":{"type":"array","items":{"type":"string"}},"tags":{"type":"array","items":{"type":"string"}},"terminals":{"type":"array","items":{"$ref":"#/$defs/terminal"}},"primitives":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/primitive"}}},"additionalProperties":false}
  }
}
