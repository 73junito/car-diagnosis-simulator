{
  "schema_version": "1.0.0",
  "artifact_type": "agent-orchestration-foundation",
  "phase": "phase-1-foundation",
  "default_policy": "deny",
  "agents": [
    {"id":"evidence-agent","capabilities":["source-discovery","claim-source-mapping","citation-validation"],"may_prepare":true,"may_human_approve":false,"may_release":false},
    {"id":"rights-agent","capabilities":["rights-review","reuse-classification"],"may_prepare":true,"may_human_approve":false,"may_release":false},
    {"id":"curriculum-agent","capabilities":["curriculum-structure","competency-mapping","lesson-planning"],"may_prepare":true,"may_human_approve":false,"may_release":false},
    {"id":"question-agent","capabilities":["question-drafting","distractor-generation","feedback-drafting"],"may_prepare":true,"may_human_approve":false,"may_release":false},
    {"id":"technical-review-agent","capabilities":["technical-review-preparation"],"may_prepare":true,"may_human_approve":false,"may_release":false},
    {"id":"instructional-review-agent","capabilities":["instructional-review-preparation"],"may_prepare":true,"may_human_approve":false,"may_release":false},
    {"id":"assessment-governance-agent","capabilities":["scoring-preparation","assessment-eligibility-preparation","delivery-governance-preparation"],"may_prepare":true,"may_human_approve":false,"may_release":false},
    {"id":"software-engineering-agent","capabilities":["code-change","test-authoring","branch-pr-preparation"],"may_prepare":true,"may_human_approve":false,"may_release":false},
    {"id":"validation-agent","capabilities":["deterministic-validation","test-execution","policy-validation"],"may_prepare":true,"may_human_approve":false,"may_release":false},
    {"id":"release-agent","capabilities":["release-preparation","deployment-verification"],"may_prepare":true,"may_human_approve":false,"may_release":false}
  ],
  "states": [
    "drafted",
    "evidence_mapped",
    "rights_reviewed",
    "technically_reviewed",
    "citation_validated",
    "instructionally_reviewed",
    "final_content_approved",
    "item_generated",
    "exact_payload_validated",
    "item_review_approved",
    "final_item_approved",
    "scoring_definition_prepared",
    "scoring_definition_approved",
    "assessment_eligibility_prepared",
    "low_stakes_formative_eligible",
    "scored_delivery_prepared",
    "scored_delivery_enabled",
    "production_api_review_prepared",
    "production_api_ineligible",
    "production_api_eligible",
    "assessment_release_prepared",
    "assessment_released"
  ],
  "transitions": [
    {"from":"drafted","to":"evidence_mapped","actors":["evidence-agent"]},
    {"from":"evidence_mapped","to":"rights_reviewed","actors":["rights-agent"]},
    {"from":"rights_reviewed","to":"technically_reviewed","actors":["technical-review-agent"]},
    {"from":"technically_reviewed","to":"citation_validated","actors":["evidence-agent"]},
    {"from":"citation_validated","to":"instructionally_reviewed","actors":["instructional-review-agent"]},
    {"from":"instructionally_reviewed","to":"final_content_approved","actors":["human"],"requires_explicit_human_approval":true},
    {"from":"final_content_approved","to":"item_generated","actors":["question-agent"]},
    {"from":"item_generated","to":"exact_payload_validated","actors":["validation-agent"]},
    {"from":"exact_payload_validated","to":"item_review_approved","actors":["human"],"requires_explicit_human_approval":true},
    {"from":"item_review_approved","to":"final_item_approved","actors":["human"],"requires_explicit_human_approval":true},
    {"from":"final_item_approved","to":"scoring_definition_prepared","actors":["assessment-governance-agent"]},
    {"from":"scoring_definition_prepared","to":"scoring_definition_approved","actors":["human"],"requires_explicit_human_approval":true},
    {"from":"scoring_definition_approved","to":"assessment_eligibility_prepared","actors":["assessment-governance-agent"]},
    {"from":"assessment_eligibility_prepared","to":"low_stakes_formative_eligible","actors":["human"],"requires_explicit_human_approval":true},
    {"from":"low_stakes_formative_eligible","to":"scored_delivery_prepared","actors":["assessment-governance-agent"]},
    {"from":"scored_delivery_prepared","to":"scored_delivery_enabled","actors":["human"],"requires_explicit_human_approval":true},
    {"from":"scored_delivery_enabled","to":"production_api_review_prepared","actors":["assessment-governance-agent"]},
    {"from":"production_api_review_prepared","to":"production_api_ineligible","actors":["human"],"requires_explicit_human_approval":true},
    {"from":"production_api_review_prepared","to":"production_api_eligible","actors":["human"],"requires_explicit_human_approval":true,"requires_runtime_verification":true},
    {"from":"production_api_eligible","to":"assessment_release_prepared","actors":["release-agent"]},
    {"from":"assessment_release_prepared","to":"assessment_released","actors":["human"],"requires_explicit_human_approval":true}
  ],
  "global_invariants": [
    "Agents may prepare governance decisions but may not synthesize human approval.",
    "No transition may skip an intermediate governance state.",
    "Production API eligibility does not imply assessment release.",
    "Assessment release does not imply institutional, high-stakes, certification, or licensure authority.",
    "Unknown agents, states, permissions, and transitions fail closed.",
    "Existing assessment and release authority is unchanged by Phase 1."
  ]
}
