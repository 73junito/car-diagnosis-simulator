    {"id":"W_LOAD_GND","from":"LOAD1_GND","to":"GND1_MAIN","type":"ground_reference"},
    {"id":"W_ALT_REG","from":"ALT1_CTRL","to":"REG1_ALT","type":"control"},
    {"id":"W_REG_CTRL","from":"REG1_CTRL","to":"BAT1_POS","type":"control"}
