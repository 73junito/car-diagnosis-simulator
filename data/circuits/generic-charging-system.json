    {"id":"ALT1","type":"alternator","name":"Alternator Assembly","terminals":[{"id":"ALT1_BPLUS","name":"B+"},{"id":"ALT1_GND","name":"Ground"},{"id":"ALT1_CTRL","name":"Control"}]},
    {"id":"REG1","type":"regulator","name":"Voltage Regulation","terminals":[{"id":"REG1_ALT","name":"Alternator"},{"id":"REG1_CTRL","name":"Control"}]},
    {"id":"LOAD1","type":"load","name":"Vehicle Electrical Loads","terminals":[{"id":"LOAD1_PWR","name":"Power"},{"id":"LOAD1_GND","name":"Ground"}]},
    {"id":"GND1","type":"ground","name":"Chassis Ground","terminals":[{"id":"GND1_MAIN","name":"Ground"}]}
