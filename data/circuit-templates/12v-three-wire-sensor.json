    {"id":"FAULT_SIGNAL_SHORT_POWER","type":"short_to_power","targetConnectionId":"W_SENSOR_SIGNAL","targetTerminalId":"SENSOR1_SIGNAL","shortTargetTerminalId":"REF1_OUT","label":"Sensor signal short to 5 V reference"}
