    {"id":"active-signal","label":"Sensor active / signal present","activeFlows":{"power":[["W_BAT_FUSE","forward"],["W_FUSE_ECM","forward"],["W_FUSE_REF","forward"],["W_REF_SENSOR_PWR","forward"]],"ground":[["W_ECM_GND","forward"],["W_SENSOR_GND","forward"],["W_BAT_GND","reverse"]],"control":[],"signal":[["W_SENSOR_SIGNAL","forward"]]},"note":"Sensor active: the powered sensor returns an analog training signal to the controller while supply and ground/reference paths remain present."}
