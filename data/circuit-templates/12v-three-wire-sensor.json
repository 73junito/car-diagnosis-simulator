    {"id":"SENSOR1","type":"sensor","name":"Generic Three-Wire Sensor","symbolId":"electrical.sensor-generic","voltageSystemId":"SENSOR5","terminals":[{"id":"SENSOR1_PWR","name":"Reference supply","symbolTerminalId":"power"},{"id":"SENSOR1_GND","name":"Sensor ground/reference","symbolTerminalId":"ground"},{"id":"SENSOR1_SIGNAL","name":"Signal output","symbolTerminalId":"signal"}]},
