    },
    {
      "id":"key-on-command-off","label":"Key on / command off",
      "activeFlows":{"power":[],"ground":[],"control":[]},
      "note":"Key on with command off: the relay coil is not energized, the normally open relay contact remains represented open, and the load is inactive."
    },
    {
      "id":"command-on","label":"Command on / relay energized",
      "activeFlows":{
        "power":[
          ["W_BAT_CTRL_FUSE","forward"],
          ["W_CTRL_FUSE_SWITCH","forward"],
          ["W_BAT_LOAD_FUSE","forward"],
