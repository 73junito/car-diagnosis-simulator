    "SW1":{"x":400,"y":0,"width":150,"height":46,"title":"Start command","subtitle":"normally open"},
    "SOL_COIL":{"x":610,"y":0,"width":160,"height":46,"title":"Solenoid coil","subtitle":"control actuator"},
    "SOL_CONTACT":{"x":260,"y":405,"width":190,"height":50,"title":"Solenoid main contact","subtitle":"high-current switching"},
    "MTR1":{"x":585,"y":405,"width":150,"height":50,"title":"Starter motor","subtitle":"cranking load"},
    "GND1":{"x":415,"y":575,"width":170,"height":50,"title":"Engine / chassis ground","subtitle":"return reference"}
  },
