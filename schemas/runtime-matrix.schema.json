{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autolearnpro.com/schemas/runtime-matrix.schema.json",
  "title": "AutoLearnPro Runtime Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "canonicalBuildRuntime",
    "compatibilityValidation",
    "productionExecutionRuntime",
    "surfaces",
    "observability",
    "vectorRetrieval",
    "persistence",
    "lmf"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "const": "runtime-stabilization-contract" },
    "canonicalBuildRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "major", "minimumVersion", "developerPin", "packageEngineRange"],
      "properties": {
        "runtime": { "const": "node" },
        "major": { "type": "integer", "minimum": 1 },
        "minimumVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "developerPin": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "packageEngineRange": { "type": "string", "minLength": 1 }
      }
    },
    "compatibilityValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeMajors", "releaseAuthorityMajor", "releaseAuthorityVersion"],
      "properties": {
        "nodeMajors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "releaseAuthorityMajor": { "type": "integer", "minimum": 1 },
        "releaseAuthorityVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "productionExecutionRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "nodeServer"],
      "properties": {
        "provider": { "const": "cloudflare-workers" },
        "nodeServer": { "const": false }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "hostname",
          "wranglerConfig",
          "workerName",
          "workerEntry",
          "assetDirectory",
          "compatibilityDate",
          "routingAuthority"
        ],
        "properties": {
          "id": { "enum": ["public", "app", "exam"] },
          "hostname": { "type": "string", "minLength": 1 },
          "wranglerConfig": { "type": "string", "pattern": "^wrangler.*\\.jsonc$" },
          "workerName": { "type": "string", "minLength": 1 },
          "workerEntry": { "type": ["string", "null"] },
          "assetDirectory": { "type": "string", "minLength": 1 },
          "compatibilityDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "routingAuthority": { "enum": ["wrangler-config", "cloudflare-external"] }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "validator", "primaryBackend", "plannedExternalOtlpBackend", "externalOtlpStatus"],
      "properties": {
        "contract": { "type": "string", "minLength": 1 },
        "validator": { "type": "string", "minLength": 1 },
        "primaryBackend": { "type": "string", "minLength": 1 },
        "plannedExternalOtlpBackend": { "type": "string", "minLength": 1 },
        "externalOtlpStatus": { "type": "string", "minLength": 1 }
      }
    },
    "vectorRetrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "validator",
        "provider",
        "status",
        "productionActivationAllowed"
      ],
      "properties": {
        "contract": { "const": "data/architecture/vector-retrieval-policy.json" },
        "validator": { "const": "scripts/verify-vector-retrieval-policy.js" },
        "provider": { "const": "supabase-pgvector" },
        "status": { "const": "disabled-no-approved-vector-corpus" },
        "productionActivationAllowed": { "const": false }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durableBusinessDataAuthority",
        "edgeCoordination",
        "durableObjectStorage",
        "previewOrchestrationPersistence",
        "stagingOrchestrationPersistence",
        "productionOrchestrationPersistence"
      ],
      "properties": {
        "durableBusinessDataAuthority": { "type": "string", "minLength": 1 },
        "edgeCoordination": { "type": "string", "minLength": 1 },
        "durableObjectStorage": { "type": "string", "minLength": 1 },
        "previewOrchestrationPersistence": { "type": "string", "minLength": 1 },
        "stagingOrchestrationPersistence": { "type": "string", "minLength": 1 },
        "productionOrchestrationPersistence": { "type": "string", "minLength": 1 }
      }
    },
    "lmf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingProductionLabCount", "plannedUnprojectedLabCount", "runtimeCoverageValidator"],
      "properties": {
        "existingProductionLabCount": { "type": "integer", "minimum": 0 },
        "plannedUnprojectedLabCount": { "type": "integer", "minimum": 0 },
        "runtimeCoverageValidator": { "type": "string", "minLength": 1 }
      }
    }
  }
}
