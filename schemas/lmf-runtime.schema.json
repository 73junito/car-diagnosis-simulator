{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autolearnpro.com/schemas/lmf-runtime.schema.json",
  "title": "AutoLearnPro LMF Runtime Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeRole",
    "sourceContracts",
    "labId",
    "route",
    "engineeringAdapterId",
    "modelRef",
    "toolIds",
    "measurementTypes",
    "faultClassIds",
    "directPracticeAllowed",
    "assessmentEligibilityAuthority",
    "publicationAuthority"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runtimeRole": { "type": "string", "pattern": "^lmf-derived-[a-z0-9-]+-runtime$" },
    "sourceContracts": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^/data/lmf/.+\\.json$" }
    },
    "labId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "route": { "type": "string", "pattern": "^/dashboard/student/[a-z0-9-]+/$" },
    "engineeringAdapterId": { "type": "string", "minLength": 1 },
    "modelRef": { "type": "string", "pattern": "^/data/.+\\.json$" },
    "engineeringProfileRef": { "type": "string", "pattern": "^/data/.+\\.json$" },
    "toolIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^tool\\.[a-z0-9-]+$" }
    },
    "measurementTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "faultClassIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" }
    },
    "directPracticeAllowed": { "type": "boolean" },
    "assessmentEligibilityAuthority": { "const": "external-governance-only" },
    "publicationAuthority": { "const": "external-human-governance-only" }
  }
}
