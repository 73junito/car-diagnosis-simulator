{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autolearnpro.com/schemas/lab-domain-coverage.schema.json",
  "title": "Laboratory Domain Coverage",
  "description": "Maps each canonical laboratory to the engineering domains and operating modes it requires. This is a coverage plan, not evidence that any model is operational.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryRole", "canonicalRegistry", "notice", "domainIds", "labs"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "registryRole": { "const": "lab-to-domain-coverage-plan" },
    "canonicalRegistry": { "const": "data/lmf/lab-registry.json" },
    "notice": { "type": "string", "minLength": 1 },
    "domainIds": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/domainId" }
    },
    "labs": {
      "type": "array",
      "minItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "labId",
          "lifecycle",
          "primaryDomainId",
          "coupledDomainIds",
          "declaredDomainLabels",
          "modes",
          "engineStatus",
          "validationRefs",
          "notes"
        ],
        "properties": {
          "labId": { "type": "string", "minLength": 1 },
          "lifecycle": { "enum": ["existing", "planned"] },
          "primaryDomainId": { "$ref": "#/$defs/domainId" },
          "coupledDomainIds": {
            "type": "array",
            "items": { "$ref": "#/$defs/domainId" }
          },
          "declaredDomainLabels": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "modes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["engineering", "diagnostic", "integrated"],
            "properties": {
              "engineering": { "type": "boolean" },
              "diagnostic": { "type": "boolean" },
              "integrated": { "type": "boolean" }
            }
          },
          "engineStatus": {
            "enum": ["planned", "in-development", "validated", "deprecated"]
          },
          "validationRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "domainId": {
      "enum": [
        "electrical",
        "mechanical",
        "hydraulic",
        "thermal",
        "powertrain",
        "network-control",
        "vehicle-dynamics",
        "integrated-diagnostics"
      ]
    }
  }
}
