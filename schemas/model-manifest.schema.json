{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autolearnpro.com/schemas/model-manifest.schema.json",
  "title": "Model Manifest",
  "description": "Versioned declaration of what a multi-domain engineering model covers, including explicit unsupported capabilities. Mirrors contracts/model.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "modelId",
    "modelVersion",
    "status",
    "primaryDomainId",
    "coupledDomainIds",
    "applicability",
    "capabilities",
    "unsupportedMeasurementTypes",
    "simplifications",
    "dependencies",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "manifestId": { "type": "string", "minLength": 1 },
    "modelId": { "type": "string", "minLength": 1 },
    "modelVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["planned", "in-development", "validated", "deprecated"] },
    "primaryDomainId": { "$ref": "#/$defs/domainId" },
    "coupledDomainIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/domainId" }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "vehicleSpecific", "notice"],
      "properties": {
        "mode": { "enum": ["generic-training-only", "vehicle-specific"] },
        "vehicleSpecific": { "type": "boolean" },
        "notice": { "type": "string", "minLength": 1 },
        "context": { "type": "object" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityId", "domainId", "measurementTypes", "status", "validationRefs", "limitations"],
        "properties": {
          "capabilityId": { "type": "string", "minLength": 1 },
          "domainId": { "$ref": "#/$defs/domainId" },
          "measurementTypes": { "type": "array", "items": { "$ref": "#/$defs/quantityType" } },
          "status": { "enum": ["planned", "in-development", "validated", "deprecated"] },
          "validationRefs": { "type": "array", "items": { "type": "string" } },
          "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "unsupportedMeasurementTypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/quantityType" }
    },
    "simplifications": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceRole", "authoritativeSpecification"],
      "properties": {
        "evidenceRole": { "const": "project_authored_training_model" },
        "authoritativeSpecification": { "const": false }
      }
    }
  },
  "$defs": {
    "domainId": {
      "enum": [
        "electrical",
        "mechanical",
        "hydraulic",
        "thermal",
        "powertrain",
        "network-control",
        "vehicle-dynamics",
        "integrated-diagnostics"
      ]
    },
    "quantityType": {
      "enum": [
        "voltage",
        "voltage_drop",
        "current",
        "resistance",
        "continuity",
        "frequency",
        "duty_cycle",
        "waveform",
        "network_voltage",
        "bus_resistance",
        "network_activity",
        "pressure",
        "vacuum",
        "compression_pressure",
        "leakdown_percent",
        "temperature",
        "rpm",
        "torque",
        "speed",
        "angle",
        "distance",
        "position",
        "command_state",
        "diagnostic_data",
        "power"
      ]
    }
  }
}
