{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TorqueMind Scenario",
  "type": "object",
  "required": ["id","symptoms","fault","tests","symptomCategory"],
  "properties": {
    "id": { "type": ["integer","string"] },
    "symptoms": { "type": "string", "minLength": 10 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "primarySystem": { "type": "string" },
    "secondarySystems": { "type": "array" },
    "symptomCategory": { "type": "string" },
    "aseArea": { "type": "string", "pattern": "^A[1-9]$" },
    "vehicleType": { "type": "string", "enum": ["gasoline","diesel","hybrid","ev"] },
    "faultType": { "type": "string", "enum": ["hard-fault","intermittent","electrical","mechanical","network"] },
    "diagnosticMode": { "type": "string", "enum": ["basic","scan-tool","waveform-analysis","guided-diagnostics"] },
    "requiredTools": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "safetyLevel": { "type": "string" },
    "fault": { "type": "string" },
    "tests": { "type": "object" }
  }
}
