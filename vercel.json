{
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://pffdgqpynpbffbcnxmum.supabase.co https://torquemind-api.onrender.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; frame-ancestors 'none';"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dashboard/analytics/",
      "destination": "/dashboard/analytics",
      "permanent": true
    },
    {
      "source": "/dashboard/student/",
      "destination": "/dashboard/student",
      "permanent": true
    },
    {
      "source": "/dashboard/student/scenario/",
      "destination": "/dashboard/student/scenario",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/",
      "destination": "/docs/index.html"
    },
    {
      "source": "/dashboard/analytics",
      "destination": "/dashboard/analytics.html"
    },
    {
      "source": "/dashboard/live-session",
      "destination": "/dashboard/live-session.html"
    },
    {
      "source": "/dashboard/session-history",
      "destination": "/dashboard/session-history.html"
    },
    {
      "source": "/dashboard/student",
      "destination": "/dashboard/student.html"
    },
    {
      "source": "/dashboard/student/index",
      "destination": "/dashboard/student/index.html"
    },
    {
      "source": "/dashboard/student/app",
      "destination": "/dashboard/student/student.html"
    },
    {
      "source": "/dashboard/student/scenario",
      "destination": "/dashboard/student/scenario/scenario.html"
    },
    {
      "source": "/dashboard/obd2",
      "destination": "/dashboard/obd2.html"
    },
    {
      "source": "/dashboard/obd2-student",
      "destination": "/dashboard/obd2-student.html"
    },
    {
      "source": "/dashboard/obd2-ase",
      "destination": "/dashboard/obd2-ase.html"
    }
  ]
}

