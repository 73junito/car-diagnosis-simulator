{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autolearnpro-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "app.autolearnpro.com",
      "zone_name": "autolearnpro.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "exports": {
    "TorqueMindRateLimitCounter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TORQUEMIND_RATE_LIMITER",
        "class_name": "TorqueMindRateLimitCounter"
      }
    ]
  },
  "vars": {
    "TORQUEMIND_ENVIRONMENT": "production",
    "SUPABASE_URL": "https://pffdgqpynpbffbcnxmum.supabase.co",
    "USE_DO_RATE_LIMIT": "true",
    "TORQUEMIND_RATE_LIMIT_MAX": "10",
    "TORQUEMIND_RATE_LIMIT_WINDOW_SECONDS": "60",
    "TORQUEMIND_AI_PROVIDER": "ollama",
    "TORQUEMIND_AI_URL": "https://ollama.autolearnpro.com/api/chat",
    "TORQUEMIND_AI_MODEL": "gpt-oss:20b-cloud",
    "TORQUEMIND_AI_TIMEOUT_MS": "120000"
  },
  "env": {
    "staging": {
      "name": "autolearnpro-app-staging",
      "workers_dev": true,
      "routes": [],
      "durable_objects": {
        "bindings": [
          {
            "name": "TORQUEMIND_RATE_LIMITER",
            "class_name": "TorqueMindRateLimitCounter"
          }
        ]
      },
      "vars": {
        "TORQUEMIND_ENVIRONMENT": "staging",
        "SUPABASE_URL": "https://jchfruprqpeypdttvlam.supabase.co",
        "USE_DO_RATE_LIMIT": "true",
        "TORQUEMIND_RATE_LIMIT_MAX": "10",
        "TORQUEMIND_RATE_LIMIT_WINDOW_SECONDS": "60",
        "TORQUEMIND_AI_PROVIDER": "ollama",
        "TORQUEMIND_AI_URL": "https://ollama.autolearnpro.com/api/chat",
        "TORQUEMIND_AI_MODEL": "gpt-oss:20b-cloud",
        "TORQUEMIND_AI_TIMEOUT_MS": "120000"
      }
    }
  }
}
