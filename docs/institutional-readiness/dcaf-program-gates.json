{
  "schema_version": "1.0",
  "program": "AutoLearnPro Research Validation and Institutional Adoption",
  "assessment_use": "formative_only",
  "scientific_validation_claim": false,
  "institutional_approval_claim": false,
  "high_stakes_eligible": false,
  "stages": [
    {
      "id": "R0",
      "name": "Governance and measurement design",
      "status": "planned",
