  "rubric": {
    "total_weight": 100,
    "dimensions": [
      {
        "id": "process",
        "weight": 25
      },
      {
        "id": "tests",
        "weight": 25
      },
      {
        "id": "reasoning",
        "weight": 20
      },
      {
        "id": "safety",
        "weight": 10
      },
      {
        "id": "verification",
        "weight": 10
      },
      {
        "id": "documentation",
        "weight": 10
      }
    ],
    "status": "illustrative_not_validated"
  },
  "controls": {
    "requires_instructor_review": true,
    "automatic_progression": false,
    "student_grading_enabled": false,
    "raw_event_mutation_allowed": false,
    "score_gate_enabled": false,
    "privacy_review_required_before_pilot": true
  }
