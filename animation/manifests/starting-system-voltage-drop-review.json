      "componentIds": [
        "digital-multimeter",
        "positive-path",
        "ground-path",
        "starter-motor"
      ],
      "timeline": {
        "kind": "clip",
        "clipId": "select-measurement-path",
        "startSeconds": 0,
        "endSeconds": 1
      },
      "highlightComponentIds": [
        "digital-multimeter",
        "positive-path",
        "ground-path",
        "starter-motor"
      ],
