{
  "name": "torquemind-api",
  "version": "0.1.0",
  "description": "TorqueMind backend (Express + Supabase)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:validate": "node scripts/validate-db-ssl.js",
    "db:validate-report": "node scripts/validate-db-ssl-report.js",
    "test": "jest --runInBand --forceExit",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "ajv": "^8.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "pg": "^8.10.0"
  },
  "devDependencies": {
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "puppeteer": "^24.43.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
