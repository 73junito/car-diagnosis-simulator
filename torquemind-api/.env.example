# Copy this to .env and fill values
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Optional: PostgreSQL direct connection settings (for advanced use / psql / server-to-server)
# SSL: set to 'require' or 'verify-full'. If using 'verify-full', set the CA cert path below.
# Example CA path: C:\\Users\\rod63\\Downloads\\prod-ca-2021.crt
PGHOST=db.your-project.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=your_supabase_db_password
# PGSSLMODE can be 'disable'|'allow'|'prefer'|'require'|'verify-ca'|'verify-full'
PGSSLMODE=verify-full
# Path to CA certificate used for server verification (Windows example):
# PGSSLROOTCERT=C:\\Users\\rod63\\Downloads\\prod-ca-2021.crt
PGSSLROOTCERT=
