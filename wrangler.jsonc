{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "car-diagnosis-simulator",

  "main": "worker/index.js",

  "compatibility_date": "2026-07-30",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./dist"
  }
  ,
  "durable_objects": {
    "bindings": [
      {
        "name": "TORQUEMIND_RATE_LIMITER",
        "class_name": "TorqueMindRateLimitCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TorqueMindRateLimitCounter"
      ]
    }
  ],
  "vars": {
    "USE_DO_RATE_LIMIT": "false"
  }
}
