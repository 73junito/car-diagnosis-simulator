{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "car-diagnosis-simulator",

  "main": "worker/index.js",

  "compatibility_date": "2026-07-30",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./dist"
  }
  ,
  "durable_objects": {
    "bindings": [
      {
        "name": "TORQUEMIND_RATE_LIMITER",
        "class_name": "TorqueMindRateLimitCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TorqueMindRateLimitCounter"
      ]
    }
  ],
  "vars": {
    "USE_DO_RATE_LIMIT": "false"
  },

  "env": {
    "staging": {
      "name": "car-diagnosis-simulator-staging",

      "durable_objects": {
        "bindings": [
          {
            "name": "TORQUEMIND_RATE_LIMITER",
            "class_name": "TorqueMindRateLimitCounter"
          }
        ]
      },

      "vars": {
        "USE_DO_RATE_LIMIT": "true",
        "TORQUEMIND_ENVIRONMENT": "staging",
        "TORQUEMIND_RATE_LIMIT_MAX": "10",
        "TORQUEMIND_RATE_LIMIT_WINDOW_SECONDS": "60"
      }
    }
  }
}
