{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autolearnpro-public",
  "main": "worker/public-index.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public-site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/health",
      "/__ping"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TORQUEMIND_RATE_LIMITER",
        "class_name": "TorqueMindRateLimitCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TorqueMindRateLimitCounter"
      ]
    }
  ],
  "env": {
    "staging": {
      "name": "car-diagnosis-simulator-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "TORQUEMIND_RATE_LIMITER",
            "class_name": "TorqueMindRateLimitCounter"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "TorqueMindRateLimitCounter"
          ]
        }
      ],
      "assets": {
        "directory": "./dist"
      }
    }
  }
}
