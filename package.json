{
  "name": "car-diagnosis-sim",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "test": "node scripts/run-tests.js",
    "build": "npm run write-version",
    "write-version": "node scripts/write-version.js",
    "vercel-build": "npm run write-version",
    "start:local-api": "node scripts/local-api.js",
    "test:live-session": "node tests/live-session-ui.test.js",
    "test:playwright": "npx playwright test tests/playwright --config=playwright.config.js",
    "start:test": "npx http-server -p 3003 -c-1 .",
    "test:all": "npm run test && npm run test:playwright",
    "validate:scenarios": "node tools/validate-scenarios.js",
    "validate:obd2": "node tools/validate-obd2.js",
    "test:analytics": "node tests/session-summary.test.js",
    "export:csv": "node tools/export-csv.js",
    "export:xapi": "node tools/export-xapi.js",
    "export:analytics": "npm run export:csv && npm run export:xapi",
    "test:analytics-api": "node tests/analytics-api.test.js",
    "test:analytics-routes": "node tests/analytics-routes.test.js",
    "lint": "eslint . --ext .js",
    "lint:tests": "eslint tests --ext .js",
    "normalize-assets": "node scripts/normalize-scenario-assets.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.24.0",
    "@playwright/test": "^1.61.0",
    "@supabase/supabase-js": "^2.108.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "acorn": "^8.17.0",
    "adm-zip": "^0.5.9",
    "ajv": "^8.20.0",
    "babel-jest": "^30.4.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.22.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.8.0",
    "husky": "^8.0.0",
    "jest": "^30.4.2",
    "jest-circus": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "node-fetch": "^3.3.2",
    "supertest": "^7.2.2",
    "undici": "^8.3.0",
    "wait-on": "^7.0.1",
    "eslint": "^9.22.0",
    "husky": "^9.1.7"
  },
  "jest": {
    "testTimeout": 30000,
    "testRunner": "jest-circus/runner",
    "setupFilesAfterEnv": [
      "<rootDir>/scripts/jest-setup-retries.js"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-results",
          "outputName": "junit.xml"
        }
      ],
      [
        "jest-html-reporter",
        {
          "pageTitle": "Car Diagnosis Simulator — Test Report",
          "outputPath": "test-results/jest-report.html"
        }
      ]
    ]
  }
}