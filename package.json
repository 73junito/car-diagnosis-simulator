{
  "name": "car-diagnosis-sim",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "minimist": "^1.2.8",
    "prepare": "husky install",
    "test": "node scripts/run-tests.js",
    "test:supabase-contracts": "node --test supabase/tests/security-contracts.test.js supabase/tests/package-integrity.test.js",
    "build": "npm run write-version && node scripts/build-static-site.js",
    "write-version": "node scripts/write-version.js",
    "test:live-session": "node tests/live-session-ui.test.js",
    "test:playwright": "npx playwright test tests/playwright --config=playwright.config.js",
    "start:test": "npx http-server -p 3003 -c-1 .",
    "test:all": "npm run test && npm run test:playwright",
    "validate:scenarios": "node tools/validate-scenarios.js",
    "validate:obd2": "node tools/validate-obd2.js",
    "test:analytics": "node tests/session-summary.test.js",
    "export:csv": "node tools/export-csv.js",
    "export:xapi": "node tools/export-xapi.js",
    "export:analytics": "npm run export:csv && npm run export:xapi",
    "test:analytics-api": "node tests/analytics-api.test.js",
    "test:analytics-routes": "node tests/analytics-routes.test.js",
    "test:provenance-db": "node scripts/test-provenance-db.js",
    "lint": "eslint . --ext .js",
    "lint:tests": "eslint tests --ext .js",
    "normalize-assets": "node scripts/normalize-scenario-assets.js",
    "evaluate-retrieval": "node scripts/evaluate-retrieval.js",
    "docs:mermaid:coverage": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-mermaid-coverage.ps1",
    "docs:mermaid:render": "node scripts/verify-mermaid-rendering.js",
    "docs:mermaid": "npm run docs:mermaid:coverage && npm run docs:mermaid:render",
    "validate:academic-pathways": "node scripts/verify-academic-pathways.js",
    "validate:course-catalog": "node scripts/verify-course-catalog.js",
    "validate:program-architecture": "node scripts/verify-program-architecture.js",
    "validate:ai-mechanic-architecture": "node scripts/verify-ai-mechanic-architecture.js",
    "validate:curriculum-content": "node scripts/verify-curriculum-content-policy.js",
    "validate:evidence-approval": "node scripts/verify-evidence-approval-contract.js",
    "validate:external-technical-references": "node scripts/verify-external-technical-references.js",
    "validate:circuits": "node scripts/verify-circuit-models.js",
    "validate:compliance-authority": "node scripts/verify-compliance-authority.js",
    "validate:student-data-inventory": "node scripts/verify-student-data-inventory.js",
    "validate:subprocessor-register": "node scripts/verify-subprocessor-register.js",
    "validate:retention-deletion-contract": "node scripts/verify-retention-deletion-contract.js",
    "validate:telemetry-payload-contract": "node scripts/verify-telemetry-payload-contract.js",
    "validate:legacy-student-data-disposition": "node scripts/verify-legacy-student-data-disposition.js",
    "validate:student-recommendation-access": "node scripts/verify-student-recommendation-access.js",
    "validate:student-progress-access": "node scripts/verify-student-progress-access.js",
    "validate:legacy-progress-retirement": "node scripts/verify-legacy-progress-retirement.js",
    "validate:curriculum-schema": "node scripts/verify-curriculum-migration-contract.js",
    "validate:curriculum-api": "node scripts/verify-curriculum-api-contract.js",
    "verify:evidence-workflow": "node scripts/verify-curriculum-evidence-workflow.js",
    "audit:curriculum-references": "node scripts/curriculum-reference-coverage-report.js --json reports/curriculum-reference-coverage.json --markdown reports/curriculum-reference-coverage.md",
    "exam:curriculum:sync": "node scripts/sync-exam-curriculum.js",
    "exam:prepare": "npm run validate:academic-pathways && npm run validate:course-catalog && npm run validate:program-architecture && npm run validate:curriculum-content && npm run exam:curriculum:sync",
    "exam:pathways:verify": "npm run exam:prepare && node scripts/verify-exam-pathway-page.js",
    "exam:catalog:verify": "npm run exam:prepare && npx playwright test tests/playwright/course-catalog.spec.js --project=chromium",
    "exam:navigation:verify": "npm run exam:prepare && npx playwright test tests/playwright/exam-sidebar-navigation.spec.js --project=chromium",
    "audit:scenario-questions": "node scripts/scenario-question-readiness-report.js",
    "cloudflare:exam:deploy": "npm run exam:prepare && wrangler deploy --config wrangler.exam.jsonc",
    "cloudflare:exam:preview": "npm run exam:prepare && wrangler dev --config wrangler.exam.jsonc",
    "cloudflare:app:build": "npm run build",
    "cloudflare:app:deploy": "npm run cloudflare:app:build && wrangler deploy --config wrangler.app.jsonc",
    "cloudflare:app:preview": "npm run cloudflare:app:build && wrangler preview --config wrangler.app.jsonc",
    "validate:symbol-library": "node scripts/verify-symbol-library.js",
    "validate:connection-library": "node scripts/verify-connection-library.js",
    "validate:engineering-parameters": "node scripts/verify-engineering-parameters.js",
    "validate:engineering-artifacts": "node scripts/verify-engineering-artifacts.js",
    "validate:ngspice-relay": "node engineering/ngspice/run-relay-load-model.js && node scripts/verify-engineering-artifacts.js",
    "validate:sensor-model": "node engineering/ngspice/run-sensor-model.js && node scripts/verify-engineering-artifacts.js",
    "validate:pwm-actuator-model": "node engineering/ngspice/run-pwm-actuator-model.js && node scripts/verify-engineering-artifacts.js",
    "validate:starting-voltage-drop-model": "node engineering/ngspice/run-starting-voltage-drop-model.js && node scripts/verify-engineering-artifacts.js",
    "validate:charging-applicability": "npx jest tests/charging-reference-applicability.test.js --runInBand",
    "validate:multivoltage-domain-isolation": "npx jest tests/multivoltage-domain-isolation.test.js --runInBand",
    "validate:browser-engineering-artifacts": "npx jest tests/browser-engineering-artifact-adapter.test.js --runInBand"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.24.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.2",
    "acorn": "^8.18.0",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "babel-jest": "^30.5.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.11.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-circus": "^30.5.1",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "minimist": "^1.2.8",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.0",
    "supertest": "^7.2.2",
    "undici": "^8.10.2",
    "wait-on": "^9.1.0",
    "wrangler": "^4.143.1"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "description": "Evidence-aware automotive technology learning, diagnostic scenario, and lab platform",
  "homepage": "https://autolearnpro.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/73junito/car-diagnosis-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/73junito/car-diagnosis-simulator/issues"
  }
}
