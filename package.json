{
  "name": "car-diagnosis-sim",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "minimist": "^1.2.8",
    "prepare": "husky install",
    "test": "node scripts/run-tests.js",
    "test:supabase-contracts": "node --test supabase/tests/security-contracts.test.js supabase/tests/package-integrity.test.js",
    "build": "npm run write-version && node scripts/build-static-site.js",
    "write-version": "node scripts/write-version.js",
    "vercel-build": "npm run build",
    "test:live-session": "node tests/live-session-ui.test.js",
    "test:playwright": "npx playwright test tests/playwright --config=playwright.config.js",
    "start:test": "npx http-server -p 3003 -c-1 .",
    "test:all": "npm run test && npm run test:playwright",
    "validate:scenarios": "node tools/validate-scenarios.js",
    "validate:obd2": "node tools/validate-obd2.js",
    "test:analytics": "node tests/session-summary.test.js",
    "export:csv": "node tools/export-csv.js",
    "export:xapi": "node tools/export-xapi.js",
    "export:analytics": "npm run export:csv && npm run export:xapi",
    "test:analytics-api": "node tests/analytics-api.test.js",
    "test:analytics-routes": "node tests/analytics-routes.test.js",
    "test:provenance-db": "node scripts/test-provenance-db.js",
    "lint": "eslint . --ext .js",
    "lint:tests": "eslint tests --ext .js",
    "normalize-assets": "node scripts/normalize-scenario-assets.js",
    "evaluate-retrieval": "node scripts/evaluate-retrieval.js",
    "docs:mermaid:coverage": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-mermaid-coverage.ps1",
    "docs:mermaid:render": "node scripts/verify-mermaid-rendering.js",
    "docs:mermaid": "npm run docs:mermaid:coverage && npm run docs:mermaid:render",
    "validate:academic-pathways": "node scripts/verify-academic-pathways.js",
    "validate:curriculum-content": "node scripts/verify-curriculum-content-policy.js",
    "validate:curriculum-schema": "node scripts/verify-curriculum-migration-contract.js",
    "validate:curriculum-api": "node scripts/verify-curriculum-api-contract.js",
    "exam:curriculum:sync": "node scripts/sync-exam-curriculum.js",
    "exam:prepare": "npm run validate:academic-pathways && npm run validate:curriculum-content && npm run exam:curriculum:sync",
    "exam:pathways:verify": "npm run exam:prepare && node scripts/verify-exam-pathway-page.js",
    "audit:scenario-questions": "node scripts/scenario-question-readiness-report.js",
    "cloudflare:exam:deploy": "npm run exam:prepare && wrangler deploy --config wrangler.exam.jsonc",
    "cloudflare:exam:preview": "npm run exam:prepare && wrangler dev --config wrangler.exam.jsonc",
    "cloudflare:app:build": "npm run build",
    "cloudflare:app:deploy": "npm run cloudflare:app:build && wrangler deploy --config wrangler.app.jsonc",
    "cloudflare:app:preview": "npm run cloudflare:app:build && wrangler preview --config wrangler.app.jsonc"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.24.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.112.4",
    "acorn": "^8.18.0",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "babel-jest": "^30.5.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.11.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-circus": "^30.5.1",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "minimist": "^1.2.8",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.0",
    "supertest": "^7.2.2",
    "undici": "^8.10.2",
    "wait-on": "^9.1.0",
    "wrangler": "^4.138.0"
  },
  "dependencies": {
    "hono": "^4.13.8"
  }
}
